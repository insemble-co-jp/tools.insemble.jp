    .pl-pr-note{flex:1}
    /* 3枚：1件 = 写真枠 112×84mm（4:3）＋記入欄。説明の欄は下の端まで伸ばし、手書きで書き足せるようにする */
    .pl-pr3 .pl-pr-row{display:grid;grid-template-columns:112mm minmax(0,1fr);height:84mm;border:0.35mm solid #000;margin-bottom:4mm}
