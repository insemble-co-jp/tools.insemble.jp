    .pl-pr3 dl{overflow:hidden}
    .pl-pr6 dl div{grid-template-columns:17mm minmax(0,1fr);font-size:8pt;line-height:1.35}
    .pl-pr6 dt,.pl-pr6 dd{padding:0.6mm 1.5mm}
  }
