  .pl-add{position:relative;flex:1 1 240px;display:flex;align-items:center;gap:12px;min-height:56px;padding:10px var(--g-sm);border:2px dashed var(--line-2);border-radius:var(--r-sm);color:var(--primary-ink);background:#fff;cursor:pointer;transition:border-color .16s,background .16s}
