---
/* ツールハブ（React なし）
   キャッチ →「やりたいことから、選ぶ」（使用イメージの絵＋こんなときの一文）→ 学ぶ → FAQ → 運営。動きは src/scripts/hub.js
   準備中のツール（hub.js の status: "soon"）は出さない（2026-11-18 に「これから公開するツール」をやめた） */
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Corp from "../components/Corp.astro";
import Icon from "../components/Icon.astro";
import SectionHead from "../components/SectionHead.astro";
import Peek from "../components/Peek.astro";
import Faq from "../components/Faq.astro";
import HUB from "../data/hub.js";
import { ORG, PUBLISHER } from "../data/org.js";
import "../styles/hub.css";

/* 並び順は hub.js の hot（こちらで決めたおすすめ順）。利用回数を数えられるようになったら uses 順も検討する */
const live = HUB.TOOLS.filter((t) => t.status === "live").sort((a, b) => (a.hot ?? 99) - (b.hot ?? 99));
const urlTools = live.filter((t) => t.url);
/* 学ぶ：公開中のツールの解説だけを、ツールのカテゴリごとに（CATS の順） */
const learn = HUB.LEARN.flatMap((l) => {
  const t = live.find((x) => x.slug === l.tool);
  return t ? [{ ...l, cat: t.cat, toolName: t.name }] : [];
});
const learnCats = HUB.CATS.filter((c) => learn.some((l) => l.cat === c.id));
const catLabel = (id: string) => HUB.CATS.find((c) => c.id === id)?.label ?? "";
/* 「やりたいことから、選ぶ」のカテゴリ：公開中のツールがあるものだけ（CATS の順） */
const liveCats = HUB.CATS.filter((c) => live.some((t) => t.cat === c.id));
/* 検索で拾うことば（全角・半角をそろえて小文字に。hub.js も同じようにそろえて比べる） */
const searchKey = (t: (typeof HUB.TOOLS)[number]) => [t.name, t.desc, t.when, t.slug, catLabel(t.cat), t.kw ?? ""].join(" ").normalize("NFKC").toLowerCase();

const site = "https://tools.insemble.jp/";
const jsonLd = [
  ORG,
  { "@context": "https://schema.org", "@type": "WebSite", name: "insemble tools", url: site, inLanguage: "ja", publisher: PUBLISHER },
  { "@context": "https://schema.org", "@type": "ItemList", name: "無料で使える便利ツール", itemListElement: live.map((t, i) => ({ "@type": "ListItem", position: i + 1, name: t.name, url: site + t.slug + "/" })) },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: HUB.FAQ.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
];

const NAV: [string, string][] = [["#tools", "ツール"], ["#learn", "学ぶ"], ...(HUB.SHOW_UPDATES ? [["#updates", "更新情報"] as [string, string]] : []), ["#faq", "よくある質問"]];
const FOOT: { h: string; items: [string, string][] }[] = [
  { h: "ツール", items: [...live.map((t) => [HUB.label(t), "/" + t.slug + "/"] as [string, string]), ["ツール一覧", "#tools"]] },
  { h: "学ぶ", items: [...learn.map((l) => [l.title, l.href] as [string, string]), ...(HUB.SHOW_UPDATES ? [["更新情報", "#updates"] as [string, string]] : [])] },
  { h: "サポート", items: [["よくある質問", "#faq"], ["insemble tools について", "/about/"]] },
];
---
<Base
  title="仕事とWeb制作の無料ツール集｜締切・PDF・席順・Excel・OGP｜insemble tools"
  description="PDFの文字や画像を取り出す、現場の写真を写真台帳にする、席順やグループを決める、予定表をExcelにする、締切までの残り時間を数える、OGPをチェックする。毎回ちょっと面倒な作業を片づける無料ツール集です。登録不要・広告なしで、ブラウザだけで使えます。"
  path="/"
  jsonLd={jsonLd}
>
  <Header nav={NAV} />

  <main>
    <!-- ===== ヒーロー（短く。ボタンで「やりたいことから、選ぶ」へ。URLはここで入力させない） ===== -->
    <section class="hub-hero">
      <div class="hero-glow"></div>
      <div class="hero-deco far" aria-hidden="true">
        <i style="width:9px;height:9px;left:13%;top:34%;background:var(--primary);opacity:.45"></i>
        <i style="width:13px;height:13px;left:80%;top:56%;border:2px solid var(--primary);opacity:.3"></i>
        <i style="width:5px;height:5px;left:52%;top:14%;background:oklch(0.66 0.10 162);opacity:.5"></i>
      </div>
      <div class="hero-deco near" aria-hidden="true">
        <i style="width:7px;height:7px;left:86%;top:26%;background:oklch(0.62 0.09 235);opacity:.4"></i>
        <i style="width:8px;height:8px;left:20%;top:64%;border:2px solid oklch(0.62 0.10 162);opacity:.35"></i>
      </div>
      <div class="wrap hub-hero-in">
        <h1 class="hub-h1"><Icon name="sparkle" size={14} />無料で使える 仕事とWeb制作のツール集</h1>
        <p class="hub-title">仕事の<span class="hl">ちょっと面倒</span>を、<br />ブラウザだけで片づける。</p>
        <p class="hub-sub">写真台帳、席順、締切の管理、OGPの確認まで。{live.length}のツールを、登録なし・広告なしで使えます。写真や名前は送信せず、ブラウザの中で処理します。</p>
        <a class="btn btn-primary hub-jump" href="#pick">やりたいことから選ぶ<Icon name="chevron" size={16} /></a>
      </div>
    </section>

    <div class="wrap" id="tools" style="scroll-margin-top:72px">
      <!-- お気に入り／最近使った は JS で出す -->
      <div id="my-slot"></div>

      <!-- ===== やりたいことから、選ぶ（ここが主役。同じツールをほかの場所で2回並べない） ===== -->
      <section class="show" id="pick" aria-labelledby="pick-h">
        <div class="show-head">
          <h2 class="show-t" id="pick-h">やりたいことから、選ぶ</h2>
          <!-- ツールを探す専用。入れたそばから下の一覧を絞り込む（URLを貼ったときは、OGPチェッカーへのリンクを出すだけで、勝手には動かさない） -->
          <search class="show-q">
            <form id="hub-search" data-clarity-mask="True">
              <Icon name="search" size={16} />
              <input type="search" name="q" enterkeyhint="search" autocomplete="off" autocorrect="off" autocapitalize="none" spellcheck="false" placeholder="ツール名・やりたいことで探す" aria-label="ツールを探す" aria-controls="live-list" />
              <button type="button" id="hub-clear" aria-label="入力を消す" hidden><Icon name="x" size={14} /></button>
            </form>
          </search>
        </div>
        {urlTools[0] && (
          <p class="show-url" id="hub-url" hidden data-clarity-mask="True">
            <a id="hub-url-link" href={"/" + urlTools[0].slug + "/"} data-open={urlTools[0].slug}>このURLを{urlTools[0].name}で確認する<Icon name="arrow" size={14} /></a>
          </p>
        )}
        <div class="chips show-cats" role="group" aria-label="カテゴリで絞り込む">
          <button type="button" class="chip on" data-cat="all" aria-pressed="true">すべて（{live.length}）</button>
          {liveCats.map((c) => <button type="button" class="chip" data-cat={c.id} aria-pressed="false">{c.label}</button>)}
        </div>
        <!-- 絞り込んだ件数を読み上げる（画面には出さない。起動時は空のまま） -->
        <p class="vh" id="hit-n" role="status"></p>
        <p class="show-none" id="no-hit" hidden>「<span id="no-hit-q"></span>」に合うツールが見つかりませんでした。別のことばでも探してみてください。</p>
        <div class="show-grid" id="live-list">
          {live.map((t) => (
            <div class="sc" id={"t-" + t.slug} data-search={searchKey(t)} data-cat={t.cat}>
              <a class="sc-link" href={"/" + t.slug + "/"} data-open={t.slug}>
                <div class="sc-peek" aria-hidden="true"><Peek slug={t.slug} /></div>
                <span class="sc-name">{t.name}{t.isNew && <span class="lbl new">NEW</span>}<Icon name="arrow" size={15} /></span>
                <span class="sc-when">{t.when}</span>
              </a>
              <button type="button" class="sc-fav" data-fav={t.slug} aria-pressed="false" aria-label={`${t.name}をお気に入りに追加`}><Icon name="star" size={16} tool /></button>
            </div>
          ))}
        </div>
      </section>
    </div>

    <!-- ===== 学ぶ ===== -->
    <section class="wrap sec">
      <SectionHead id="learn" kicker="学ぶ" title="仕事がもう一段ラクになる、実務のヒント" sub={`各ツールのページに載せている解説を、分野ごとにまとめました（${learn.length}本）。ツールを使う前後に読むと、準備や仕上げで迷いにくくなります。`} />
      <div class="learn-g">
        {learnCats.map((c) => (
          <section class="learn-cat" aria-labelledby={`learn-${c.id}`}>
            <h3 class="learn-h" id={`learn-${c.id}`}>{c.label}</h3>
            <div class="learn">
              {learn.filter((l) => l.cat === c.id).map((l) => (
                <a class="l-row reveal" href={l.href}>
                  <span class="l-kind">{l.kind}</span>
                  <span class="l-main">
                    <span class="l-title">{l.title}<Icon name="arrow" size={15} /></span>
                    <span class="l-desc">{l.desc}</span>
                    <span class="l-tool">{l.toolName}のページ</span>
                  </span>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    </section>

    {HUB.SHOW_UPDATES && (
      <section class="wrap sec sec-tight">
        <SectionHead id="updates" kicker="更新情報" title="いつ、何が変わったか" sub="新しいツールの公開や改善を、日付つきで記録しています。" />
        <div class="log">
          {HUB.CHANGELOG.map((u) => {
            const t = HUB.TOOLS.find((x) => x.slug === u.tool);
            return (
              <div class="log-row reveal">
                <time class="log-date">{u.date}</time>
                <span class={"log-kind k-" + (u.kind === "新規" ? "new" : u.kind === "改善" ? "up" : "fix")}>{u.kind}</span>
                <span class="log-text">{u.text}</span>
                {t && <a class="log-tool" href={"/" + t.slug + "/"}>{t.name}</a>}
              </div>
            );
          })}
        </div>
      </section>
    )}

    <!-- ===== このサイトについて ===== -->
    <section class="wrap sec">
      <SectionHead id="about" kicker="このサイトについて" title="安心して使っていただくために" />
      <div class="steps reveal">
        {HUB.TRUST.map((x, i) => (
          <div class="step">
            <div class="step-n">{String(i + 1).padStart(2, "0")}</div>
            <div class="step-t">{x.t}</div>
            <p class="step-d">{x.d}</p>
          </div>
        ))}
      </div>
      <a class="more-link" href="/about/">insemble tools について（運営者・ツールの特徴・更新履歴）<Icon name="arrow" size={15} /></a>
    </section>

    <!-- ===== よくある質問 ===== -->
    <section class="wrap sec sec-tight">
      <SectionHead id="faq" kicker="はじめての方へ" title="よくある質問" />
      <Faq items={HUB.FAQ} />
    </section>

    <Corp desc="Webサイトの制作から、業務に合わせた専用ツールの開発までお受けしています。ここにあるツールと同じように、開いてすぐに使えるものを会社やチームに合わせてつくります。「社内のこの作業、Webで片づけられないかな」という段階からでも、ご相談いただけます。" />
  </main>

  <Footer cols={FOOT} />
  <script>
    import "../scripts/hub.js";
  </script>
</Base>
