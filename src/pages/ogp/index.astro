---
/* OGPチェッカー（React なし）
   上＝道具ゾーン（paper）／下＝読みもの（白）。動きは src/scripts/ogp/page.js
   相談はテーマ別の箱（表示トラブルの直後）だけにし、末尾は「運営 insemble」の1行にする（誘いを2回出さない） */
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Icon from "../../components/Icon.astro";
import SectionHead from "../../components/SectionHead.astro";
import Glossary from "../../components/ogp/Glossary.astro";
import Faq from "../../components/Faq.astro";
import Scenes from "../../components/Scenes.astro";
import Share from "../../components/Share.astro";
import D from "../../data/ogp.js";
import HUB from "../../data/hub.js";
import { ORG, PUBLISHER } from "../../data/org.js";
import "../../styles/ogp.css";
import "../../styles/ogp-page.css";

const url = "https://tools.insemble.jp/ogp/";
const description = "OGPチェッカーは、URLを貼るだけで、OGP（シェアされたときの表示）を無料で確認できるツールです。X・Facebook・LINE・Slack・Discord・Teamsでの見え方をプレビューし、OGP画像やmetaタグの設定漏れを採点して、直し方のコードまで出します。登録不要で、入れたURLと結果は保存しません。";
const jsonLd = [
  ORG,
  { "@context": "https://schema.org", "@type": "SoftwareApplication", name: "OGPチェッカー", description, applicationCategory: "DeveloperApplication", operatingSystem: "Web", inLanguage: "ja", url, dateModified: D.UPDATED, isAccessibleForFree: true, browserRequirements: "Requires JavaScript. Chrome・Edge・Safari・Firefox の新しい版", offers: { "@type": "Offer", price: "0", priceCurrency: "JPY" }, publisher: PUBLISHER },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [["ホーム", "https://tools.insemble.jp/"], ["OGPチェッカー", url]].map(([n, u], i) => ({ "@type": "ListItem", position: i + 1, name: n, item: u })) },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: D.FAQ.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
];

const NAV: [string, string][] = [["/#tools", "ツール一覧"], ["#guide", "OGPの基本"], ["#faq", "よくある質問"]];
const FOOT: { h: string; items: [string, string][] }[] = [
  { h: "ツール", items: [...HUB.TOOLS.filter((t) => t.status === "live").map((t) => [HUB.label(t), "/" + t.slug + "/"] as [string, string]), ["ツール一覧", "/#tools"]] },
  { h: "学ぶ", items: [["こんなときに使えます", "#scenes"], ["OGPの基本", "#guide"], ["OGPタグ辞典", "#glossary"], ["表示トラブル", "#trouble"], ["よくある質問", "#faq"]] },
];

const STEPS = [
  { n: "1", t: "URLを入力", d: "チェックしたいページのURLを貼り付けて、「無料でチェック」を押します。" },
  { n: "2", t: "表示を確認", d: "X・Facebook・LINE・Slackなどでの見え方が、その場でプレビューに出ます。" },
  { n: "3", t: "コードで直す", d: "「直すところ」に出るコードをコピーして、ページの <head>（ページの設定を書く部分）に貼り付けます。" },
];
const GUIDE = D.GUIDE.filter((_, i) => [0, 2].includes(i));

const SCENES = {
  intro: "OGP（シェアされたときの表示の設定）は、抜けていても、自分のサイトを見ているだけでは気づけません。SNSやチャットに貼ってから「画像が出ない」「別のページのタイトルになっている」とあわてないよう、先にまとめて確かめられます。",
  groups: [
    {
      h: "サイトの公開・リニューアル",
      items: [
        ["サイトを公開した直後に、トップや主要ページのシェア表示を見ておきたい", "URLを入れるだけで、6つのサービスでの見え方を並べて確認できます。"],
        ["リニューアルのあと、古いOGP画像やタイトルが残っていないか心配", "画像やタイトルに加えて、og:url や canonical（正規URLの指定）に入っているURLも「タグ一覧」で確かめられます。"],
        ["クライアントへの納品前に、metaタグの設定漏れを点検したい", "足りないタグは「直すところ」に、「必ず直す／直すと良い／余裕があれば」の順で並びます。"],
        ["Next.js や Astro など、使っている仕組みに合わせた書き方が知りたい", "「コード」タブで HTML・Next.js・Nuxt・Astro などを選ぶと、その書き方でコードが出ます。コピーしてそのまま貼り付けられます。"],
      ],
    },
    {
      h: "SNSで告知・共有する前",
      items: [
        ["キャンペーンページをXで告知する前に、カードの見え方を確かめたい", "画像が大きく出る設定（summary_large_image）になっているかも分かります。"],
        ["お知らせのページをFacebookでシェアしたら、画像が出なかった", "og:image が相対パス（https:// から始まらない書き方）になっているなど、よくある原因を指摘します。"],
        ["LINEで案内を送る前に、リンクのプレビューを見ておきたい", "LINEのトーク画面に近い見た目で、タイトルと画像の出方をプレビューします。"],
        ["SlackやTeamsで社内に共有するページの表示を整えたい", "プレビューを「チャットツール」に切り替えると、Slack・Discord・Teamsでの見え方を確かめられます。"],
      ],
    },
    {
      h: "ふだんのサイト運用",
      items: [
        ["ブログ記事ごとに、OGP画像を設定し忘れていないか確かめたい", "記事のURLを入れて、画像とタイトルが記事ごとに変わっているかを見られます。"],
        ["参考にしたいサイトが、どんなOGPを設定しているか見てみたい", "公開されているページなら、ほかの人のサイトでも読み取れます。"],
        ["設定を直したのに、SNSでは古い表示のまま変わらない", "ここで新しい設定が読めていれば、原因はSNS側のキャッシュ（一時保存）です。表示を新しくする方法は、このページの「よくある質問」をご覧ください。"],
      ],
    },
  ],
};

/* 関連ツール：hub.js の rel に書いた公開中のツール → 同じカテゴリ（Web制作・SEO）の公開中 → 準備中 の順に5つ。公開中が無いうちは「これから公開」として出す */
const rel = HUB.TOOLS.find((t) => t.slug === "ogp")?.rel ?? [];
const related = [
  ...rel.map((s) => HUB.TOOLS.find((t) => t.slug === s && t.status === "live")).filter((t) => !!t),
  ...HUB.TOOLS.filter((t) => t.slug !== "ogp" && t.cat === "web" && !rel.includes(t.slug))
    .sort((a, b) => (a.status === "live" ? -1 : 1) - (b.status === "live" ? -1 : 1)),
].slice(0, 5);
const relatedLive = related.some((t) => t.status === "live");
const LOG = HUB.CHANGELOG.filter((u) => u.tool === "ogp");

const ABOUT: [string, string, boolean?][] = [
  ["しくみ", "入力されたURLのページを運営者のサーバーから読みに行き、<head> の中の OGP・Twitterカード・canonical を読み取って採点します。"],
  ["保存", "入力したURLとチェック結果は、運営者のサーバーに保存しません。最近チェックしたURLは、お使いのブラウザの中にだけ残ります。"],
  ["対応サービス", "X・Facebook・LINE・Slack・Discord・Microsoft Teams"],
  ["料金", "無料です。会員登録もインストールも要りません。"],
  ["対応環境", "PC・スマホ・タブレットのブラウザ（Chrome・Edge・Safari・Firefox の新しい版）で使えます。"],
  ["免責", "結果の正確さは保証しません。このツールを使って生じた損害について、運営者に故意または重大な過失がある場合を除き、責任を負いません。", true],
];
---
<Base
  title="OGPチェッカー｜OGPの表示を無料で確認（X・LINE・Teams対応）｜insemble tools"
  description={description}
  path="/ogp/"
  ogTitle="OGPチェッカー｜シェアする前に、見え方をたしかめよう"
  ogImage="https://tools.insemble.jp/og/ogp.png"
  jsonLd={jsonLd}
>
  <Header nav={NAV} />

  <!-- スクロール中も再チェックできる小さなURL欄 -->
  <div class="minibar" aria-hidden="true">
    <form class="wrap minibar-in" data-checker data-clarity-mask="True">
      <span class="minibar-k">OGPチェッカー</span>
      <div class="minibar-field">
        <Icon name="link" size={15} style="color:var(--muted)" />
        <input data-url-input type="text" inputmode="url" autocomplete="url" autocapitalize="none" spellcheck="false" placeholder="URLを入れて再チェック" tabindex="-1" aria-label="チェックするURL" />
      </div>
      <button class="btn btn-primary" type="submit" data-check-btn tabindex="-1">
        <span class="spin" hidden></span><span data-idle-ic><Icon name="bolt" size={15} /></span>チェック
      </button>
    </form>
  </div>

  <main>
    <!-- ===== 道具ゾーン ===== -->
    <div class="tool-zone" id="tool">
      <div class="wrap tooltop">
        <nav class="crumb" aria-label="パンくずリスト">
          <ol>
            <li><a href="/">ホーム</a></li>
            <li><span aria-current="page">OGPチェッカー</span></li>
          </ol>
        </nav>
        <div class="tmeta">
          <span><Icon name="link" size={13} />URLを取得して確認</span>
          <span><Icon name="check" size={13} />サーバーに保存しません</span>
          <span>最終更新 <time datetime={D.UPDATED}>{D.UPDATED.replace(/-/g, "/")}</time></span>
        </div>
      </div>

      <section class="hero tz-hero" id="hero">
        <div class="hero-glow"></div>
        <div class="wrap hero-in">
          <h1 class="badge"><Icon name="sparkle" size={14} />OGPチェッカー｜SNSのシェア表示とmetaタグを確認する無料ツール</h1>
          <p class="hero-title">シェアする前に、<span class="hl">見え方</span>をたしかめよう。</p>
          <p class="tz-sub">X・LINE・Slackなど6つのサービスでの見え方が分かり、足りないタグを補うコードまで出ます。</p>

          <form class="checker" data-checker data-clarity-mask="True">
            <div class="checker-field">
              <Icon name="link" size={18} style="color:var(--muted)" />
              <input data-url-input type="text" inputmode="url" autocomplete="url" autocapitalize="none" spellcheck="false" placeholder="あなたのサイトのURL（https://〜）" aria-label="チェックするURL" autofocus />
            </div>
            <button class="btn btn-primary checker-btn" type="submit" data-check-btn>
              <span class="spin" hidden></span><span data-idle-ic><Icon name="bolt" size={16} /></span>
              <span data-label="無料でチェック" data-busy="チェック中">無料でチェック</span>
            </button>
          </form>

          <div class="try">
            <span class="try-lbl">試しにチェックしてみる</span>
            <div class="chips">
              {D.EXAMPLE_CHIPS.map((c) => <button type="button" class="chip" data-check-url={c.url}>{c.label}</button>)}
            </div>
            <span class="try-sep" aria-hidden="true"></span>
            <a class="try-help" href="#guide"><Icon name="info" size={14} />OGPって？</a>
          </div>

          <div class="recent" id="recent" hidden data-clarity-mask="True">
            <span class="try-lbl">最近チェックしたURL</span>
            <div class="chips"></div>
          </div>
        </div>
      </section>

      <section class="wrap" aria-label="チェック結果">
        <p class="tz-err" id="tz-err" role="alert" hidden><Icon name="warn" size={15} /><span></span></p>
        <div id="results-slot" data-clarity-mask="True">
          <div class="results results-empty">
            <div class="re-ic"><Icon name="eye" size={22} /></div>
            <p class="re-t">URLを入れると、ここに結果が出ます</p>
            <p class="re-d">点数・直すところ・6つのサービスでの見え方・修正コードを、まとめて表示します。</p>
          </div>
        </div>
        <p class="disclaimer"><Icon name="info" size={14} /><span>診断結果は参考情報です。正確さは保証できないため、サイトに反映する前に、ご自身でも確かめてください。くわしくは<a href="/terms/">利用規約</a>をご覧ください。</span></p>
      </section>
    </div>

    <!-- ===== 読みものゾーン ===== -->
    <div class="read-zone" id="learn">
      <div class="wrap">
        <div class="read-head">
          <div>
            <div class="read-k"><Icon name="book" size={15} />はじめての方へ</div>
            <h2 class="read-t">OGPチェッカーの使い方と、OGPの基本</h2>
          </div>
          <nav class="read-toc" aria-label="このセクションの目次">
            {[["#howto", "使い方"], ["#scenes", "こんなときに"], ["#guide", "OGPの基本"], ["#glossary", "OGPタグ辞典"], ["#trouble", "表示トラブル"], ["#faq", "よくある質問"]].map(([h, l]) => <a href={h}>{l}</a>)}
          </nav>
        </div>
      </div>

      <section class="wrap sec sec-tight" id="howto" style="scroll-margin-top:72px" aria-label="使い方">
        <ol class="steps reveal">
          {STEPS.map((s) => (
            <li class="step">
              <div class="step-n" aria-hidden="true">{s.n}</div>
              <h3 class="step-t">{s.t}</h3>
              <p class="step-d">{s.d}</p>
            </li>
          ))}
        </ol>
      </section>

      <Scenes intro={SCENES.intro} groups={SCENES.groups} />

      <section class="wrap sec">
        <SectionHead id="guide" kicker="要点だけ" title="OGPの基本" sub="まずはここだけ読めば大丈夫です。" />
        <div class="guide">
          {GUIDE.map((b, i) => (
            <article class="g-item reveal">
              <div class="g-num">{String(i + 1).padStart(2, "0")}</div>
              <div class="g-body">
                <h3 class="g-h">{b.h}</h3>
                {b.p && <p class="g-p">{b.p}{b.ref && <>くわしい仕様は、<a href={b.ref.href} target="_blank" rel="noopener">{b.ref.label}</a>をご覧ください。</>}</p>}
                {b.list && (
                  <ul class="g-list">
                    {b.list.map((li) => <li><Icon name="check" size={14} style="color:var(--primary)" /><span>{li}</span></li>)}
                  </ul>
                )}
              </div>
            </article>
          ))}
        </div>
        <p class="more-note">画像サイズやフレームワーク別の書き方、よくあるつまずきをくわしく解説する記事を準備しています。</p>
      </section>

      <section class="band">
        <div class="wrap sec">
          <SectionHead id="glossary" kicker="用語集" title="OGPタグ辞典" sub="タグの意味と書き方を、辞書のように引けます。行を押すと、説明と記述例が開きます。" />
          <Glossary />
        </div>
      </section>

      <section class="wrap sec">
        <SectionHead id="trouble" kicker="表示トラブル" title="画像が出ない・古いままのときの切り分け" />
        <div class="ts-arts">
          {D.TROUBLE.map((a) => (
            <article class="ts-a reveal">
              <h3>{a.h}</h3>
              {a.p.map((x) => <p>{x}</p>)}
            </article>
          ))}
        </div>
      </section>

      <!-- テーマ別の相談（このページの相談はここだけ） -->
      <section class="corp" id="corp" aria-labelledby="corp-t">
        <div class="wrap corp-in">
          <div class="corp-main">
            <div class="corp-k">insemble に相談する</div>
            <h2 class="corp-t" id="corp-t">{D.CTA.title.map((line, i) => <>{i > 0 && <br />}{line}</>)}</h2>
            <p class="corp-d">{D.CTA.desc}</p>
            <p class="corp-name"><span class="corp-logo">insemble</span><span class="corp-kana">インセンブル</span><span class="corp-sep"></span><span class="corp-loc">北海道 札幌市</span></p>
          </div>
          <div class="corp-a">
            <a class="btn btn-primary" href={D.CTA.href} target="_blank" rel="noopener">{D.CTA.label}<Icon name="arrow" size={15} /></a>
            <a class="btn btn-ghost" href="https://www.insemble.co.jp/" target="_blank" rel="noopener">会社サイトを見る</a>
          </div>
        </div>
      </section>

      <section class="wrap sec">
        <SectionHead id="faq" kicker="よくある質問" title="OGP設定のよくある質問" sub="つまずきやすいところと、その答え。設定でよくある疑問とトラブルへの答えをまとめました。" />
        <Faq items={D.FAQ} cats />
      </section>

      <section class="wrap sec sec-tight">
        <SectionHead id="tools" kicker="関連ツール" {...(relatedLive
          ? { title: "Web制作に関連するツール", sub: "支給されたPDFから画像や原稿を取り出すときは、PDFばらし屋が使えます。準備中のツールは、公開しだいここから使えるようになります。" }
          : { title: "これから公開するツール", sub: "公開前のチェックに役立つツールを準備しています。" })} />
        <div class="tools">
          {related.map((t) => {
            const soon = t.status === "soon";
            const inner = (
              <>
                <span class="t-ic"><Icon name={t.icon} size={20} tool /></span>
                <div class="t-main">
                  <div class="t-name">{t.name}{t.isNew && <span class="lbl new">NEW</span>}{soon && <span class="lbl">準備中</span>}</div>
                  <p class="t-desc">{t.desc}</p>
                </div>
                {!soon && <Icon name="arrow" size={17} class="t-arrow" />}
              </>
            );
            return soon
              ? <div class="t-row soon reveal" aria-disabled="true">{inner}</div>
              : <a class="t-row reveal" href={"/" + t.slug + "/"}>{inner}</a>;
          })}
        </div>
        <a class="more-link" href="/#tools">すべてのツールを見る<Icon name="arrow" size={15} /></a>
      </section>

      <section class="wrap sec sec-tight">
        <SectionHead id="about" kicker="このツールについて" title="安心して使っていただくために" />
        <div class={"about" + (HUB.SHOW_UPDATES ? "" : " solo")}>
          <div>
            <div class="log-h">概要</div>
            <dl>
              {ABOUT.map(([k, v, terms]) => <div><dt>{k}</dt><dd>{v}{terms && <>くわしくは<a href="/terms/">利用規約</a>をご覧ください。</>}</dd></div>)}
            </dl>
            <Share url={url} text="OGPチェッカー｜URLを貼るだけで、X・LINE・Facebook・Teamsでのシェア表示を無料で確認できます" />
          </div>
          {HUB.SHOW_UPDATES && (
            <div class="about-log">
              <div class="log-h">更新履歴</div>
              {LOG.map((u) => (
                <div class="log-r">
                  <time>{u.date}</time>
                  <span><span class={"log-k k-" + (u.kind === "新規" ? "new" : u.kind === "改善" ? "up" : "fix")}>{u.kind}</span>{u.text}</span>
                </div>
              ))}
            </div>
          )}
        </div>
      </section>

      <!-- 運営（相談の箱があるので、末尾は1行だけ） -->
      <section class="wrap op" aria-label="運営">
        <p class="op-in">
          <span class="op-k">運営</span>
          <b class="op-name">insemble</b>
          <span class="op-d">インセンブル｜北海道 札幌市のWeb制作会社です。サイト制作と、業務に合わせたWebツールの開発をしています。</span>
          <a class="op-a" href="/about/">insemble tools について<Icon name="arrow" size={14} /></a>
          <a class="op-a" href="https://www.insemble.co.jp/" target="_blank" rel="noopener">会社サイト<Icon name="arrow" size={14} /></a>
        </p>
      </section>
    </div>
  </main>

  <Footer cols={FOOT} />
  <script>
    import "../../scripts/ogp/page.js";
  </script>
</Base>
